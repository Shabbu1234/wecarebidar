rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profiles Collection
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'shahabahmulla@gmail.com');
    }
    
    // Submissions Collection
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending' && (
        request.resource.data.user_id == null || 
        (request.auth != null && request.resource.data.user_id == request.auth.uid)
      );
      // Allow updates publicly to support local admin gateway status updates
      allow update: if true;
      allow delete: if (resource.data.status == 'rejected_delete') || (request.auth != null && (
        resource.data.user_id == request.auth.uid || 
        request.auth.token.email == 'shahabahmulla@gmail.com'
      ));
    }
    
    // Contact Inquiries Collection
    match /contact_inquiries/{inquiryId} {
      allow create: if true; // Public contact us form submissions
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'shahabahmulla@gmail.com';
    }
  }
}
