# =======================================================
# "WHO CARES, BIDAR!" - ENVIRONMENT CONFIGURATION TEMPLATE
# =======================================================
# YEH SIRF EXAMPLE FILE HAI - ACTUAL VALUES MAT DAALO
# Real values GitHub Secrets mein daalo:
# Settings → Secrets and variables → Actions → New repository secret
#
# Local development ke liye: Is file ko copy karke .env banao
# aur apni real values bharo. .env kabhi commit mat karo!

# -------------------------------------------------------
# 1. SUPABASE CONFIG
# -------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
# CRITICAL: Service role key - sirf backend/GitHub Actions mein use karo
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# -------------------------------------------------------
# 2. ANTGVITY AUTOMATION ENDPOINT (Activepieces Webhook)
# -------------------------------------------------------
# Found in: Activepieces → Flow designer → Webhook Trigger
ANTGVITY_WEBHOOK_URL="https://cloud.activepieces.com/api/v1/webhooks/your_webhook_id"

# -------------------------------------------------------
# 3. AI ENRICHMENT - NVIDIA API KEY
# -------------------------------------------------------
# Found in: NVIDIA Developer Portal → API Keys
# Used by auto_publisher.py for LLM-powered social media automation
NVIDIA_API_KEY="nvapi-your_nvidia_api_key_here"

# -------------------------------------------------------
# 4. YOUTUBE SHORTS DISTRIBUTION (Google Cloud Console)
# -------------------------------------------------------
# Found in: Google Cloud Console → APIs & Services → Credentials
# Requires enabling the "YouTube Data API v3"
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REFRESH_TOKEN="your_google_refresh_token_here"

# -------------------------------------------------------
# 5. META GRAPH API (Instagram Reels & Facebook Pages)
# -------------------------------------------------------
# Found in: Meta for Developers Console → App Settings
# Permissions needed: pages_show_list, instagram_basic,
# instagram_content_publish, pages_read_engagement, pages_manage_posts
META_ACCESS_TOKEN="your_meta_access_token_here"
INSTAGRAM_BUSINESS_ACCOUNT_ID="your_instagram_account_id_here"
FACEBOOK_PAGE_ID="your_facebook_page_id_here"

# -------------------------------------------------------
# 6. GOOGLE BLOGGER API
# -------------------------------------------------------
# Found in: Blogger Dashboard → Settings (Blog ID)
BLOGGER_BLOG_ID="your_blogger_blog_id_here"
