{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".env",
      ".env.example",
      ".gitignore",
      ".git/**",
      ".github/**",
      ".agents/**",
      "node_modules/**",
      "web_server.py",
      "auto_publisher.py",
      "monitor_doh.py",
      "query_doh.py",
      "configure_project.py",
      "agent_setup.py",
      "agent_chrome_setup.py",
      "take_screenshot.py",
      "antgvity_workflow.json",
      "wecarebidar_workflow.md",
      "skills-lock.json",
      "temp_uploads/**",
      "browser-use/**",
      "chrome_user_data/**",
      "chrome_debug_profile/**",
      "__pycache__/**",
      "package.json",
      "package-lock.json",
      "netlify.toml"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/feed",
        "destination": "/feed.html"
      },
      {
        "source": "/upload",
        "destination": "/upload.html"
      },
      {
        "source": "/leaderboard",
        "destination": "/leaderboard.html"
      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/contact",
        "destination": "/contact.html"
      },
      {
        "source": "/profile",
        "destination": "/profile.html"
      },
      {
        "source": "/moderation",
        "destination": "/moderation.html"
      },
      {
        "source": "/admin",
        "destination": "/admin_gateway.html"
      }
    ]
  }
}
